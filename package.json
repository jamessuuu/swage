{
  "name": "swage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:gpu": "playwright test --project=smoke-gpu",
    "test:e2e:cpu": "playwright test --project=smoke-cpu",
    "train": "tsx scripts/train.ts",
    "data-check": "tsx scripts/data-check.ts",
    "eval": "tsx scripts/eval-check.ts",
    "brand": "node scripts/brand.mjs --project=swage --out=public/brand",
    "collect": "vite --config scripts/collect/vite.config.ts",
    "mirror-asl-now": "tsx scripts/mirror-asl-now.ts"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "sharp": "^0.35.3",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@9.15.4"
}
